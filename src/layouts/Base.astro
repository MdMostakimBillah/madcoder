---
import "../styles/global.css";
import { asset } from "../lib/asset.js";
import { identity, socials, siteDescription } from "../data/site.js";

const title = `${identity.fullName} — Front-end Developer`;
const description = siteDescription;
const ogImage = "https://mdmostakimbillah.github.io/madcoder/img/mostakim.webp";

// Inside the installed app — standalone, minimal-ui or the Windows
// controls overlay, plus iOS Safari's navigator.standalone, which
// predates display-mode — the window chrome shows only the name: the
// role suffix reads fine in a browser tab but is noise in a title
// bar. Display mode cannot change during a document's life, so one
// check at parse time covers it, and running inline before load means
// the title bar never paints the suffix at all.
const installedTitle = `(function () {
  var installed =
    window.matchMedia("(display-mode: standalone)").matches ||
    window.matchMedia("(display-mode: minimal-ui)").matches ||
    window.matchMedia("(display-mode: window-controls-overlay)").matches ||
    navigator.standalone === true;
  if (installed) document.title = ${JSON.stringify(identity.fullName)};
})();`;

// @font-face with base-aware URLs — plain CSS can't prefix `base`, and the
// dev server doesn't rewrite root-relative public paths the way the build
// does, so this is emitted here instead of in global.css.
const fontCss = [
  { weight: "400", file: "fonts/calibri-regular.woff2" },
  { weight: "700", file: "fonts/calibri-bold.woff2" },
]
  .map(
    ({ weight, file }) => `@font-face {
  font-family: "Calibri";
  src: url("${asset(file)}") format("woff2");
  font-weight: ${weight};
  font-style: normal;
  font-display: swap;
}`,
  )
  .join("\n");

// Structured data for search engines and AI crawlers.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.fullName,
  alternateName: "Mostakim Billah",
  jobTitle: "Front-end Developer",
  description: identity.blurb,
  url: "https://mdmostakimbillah.github.io/madcoder/",
  image: ogImage,
  sameAs: socials.filter((social) => social.href.startsWith("http")).map((social) => social.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.fullName} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16130f" media="(prefers-color-scheme: dark)" />

    <!--
      Reveal-on-scroll is styled only under `.motion`, so it must be set
      before first paint: the motion layer is imported after hydration, and
      without an earlier hiding the copy would already be on screen when GSAP
      asked it to hide — a visible blink.

      No JS (this never runs) or prefers-reduced-motion: the class is never
      added and everything renders visible. The timeout is the failsafe —
      if the motion chunk never boots, it drops the class so nothing can be
      left hidden behind an animation that never runs. Motion.jsx stands it
      down the moment it takes over.
    -->
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        window.__motionFail = setTimeout(function () {
          document.documentElement.classList.remove("motion");
        }, 4000);
      }
    </script>

    <!--
      Resolve the theme before the stylesheet is applied, let alone before
      first paint: the class must be on <html> by the time anything renders or
      the page flashes white on every dark-mode load. Kept inline and tiny
      (no fetch) so it cannot race the render.
    -->
    <script is:inline>
      (function () {
        var LIGHT = "#faf8f4";
        var DARK = "#16130f";
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {
          /* storage unavailable (private mode) — fall back to the OS */
        }
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        var dark = stored ? stored === "dark" : mq.matches;

        function paint(isDark) {
          document.documentElement.classList.toggle("dark", isDark);
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          if (!metas.length) return;
          // Collapse the light/dark pair (which covers no-JS) into one
          // resolved value, so the browser never has to guess.
          for (var i = 1; i < metas.length; i++) metas[i].remove();
          metas[0].removeAttribute("media");
          metas[0].setAttribute("content", isDark ? DARK : LIGHT);
        }

        paint(dark);

        // No explicit choice yet? Keep following the OS if it changes.
        mq.addEventListener("change", function (e) {
          try {
            if (localStorage.getItem("theme")) return;
          } catch (err) {}
          paint(e.matches);
        });
      })();
    </script>

    <!-- Search / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />

    <!-- PWA install surface. iOS ignores <link rel="manifest">, so it
         gets the classic apple-* tags and a touch icon of its own. -->
    <link rel="manifest" href={asset("manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={asset("icons/apple-touch-icon.png")} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mostakim" />

    <style is:inline set:html={fontCss} />

    <!-- Fonts are 24 KB each; preload both so text renders immediately (font-display: swap). -->
    <link
      rel="preload"
      href={asset("fonts/calibri-regular.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={asset("fonts/calibri-bold.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Portrait sits in the glass pill on small screens only (hidden at
         lg+), so it is preloaded for that breakpoint alone. -->
    <link
      rel="preload"
      href={asset("img/mostakim.webp")}
      as="image"
      media="(max-width: 1023px)"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Installed PWA: name only in the window title bar. -->
    <script is:inline set:html={installedTitle}></script>

    <!-- Static builds freeze the year at build time; refresh it on every visit. -->
    <script is:inline>
      document.querySelectorAll("[data-year]").forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
    </script>

    <!--
      Service worker: registered after `load` so install (a full
      precache of the build output) never competes with first paint,
      and production only — the dev server serves no sw.js. The worker
      is generated by src/pwa.mjs during `astro build`, so it already
      knows every asset this deploy shipped: one visit leaves the
      whole site offline-capable, and the build timestamp it carries
      as its cache version is what lets the browser spot the update
      after the next deploy.
    -->
    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
          navigator.serviceWorker.register(`${base}/sw.js`).catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <!-- ── Liquid glass: the refraction the mobile chrome is made of ──
         Kept once, in the layout, because `filter: url(#lg-dist)` in
         global.css resolves against the document — every page needs the
         definition in its own DOM. `display: none` costs nothing: filter
         primitives are never laid out, they are just resolved by id.

         The displacement is the reference recipe verbatim (fractal noise
         at 0.008, two octaves, seed 92, blurred to a smooth field,
         mapping ±35px of it over the captured page). Two additions, both
         forced by measurement:

           · the frost is an feGaussianBlur *inside* the filter, because
             the element's own `backdrop-filter` has to stay at `blur(0)`
             — give it any real blur and Chromium stops passing the
             backdrop through the filter at all, and the refraction
             disappears with it (checked: 0.7/255 of pixel movement vs
             84/255 with the blur moved in here);
           · `color-interpolation-filters="sRGB"` so the pass runs in the
             space the screen composites in — linearRGB moves the page's
             luminance by a fraction either way, and sRGB is the one that
             matches the unfilitered backdrop it is standing in for. -->
    <svg style="display: none" aria-hidden="true" focusable="false">
      <filter id="lg-dist" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.008 0.008"
          numOctaves="2"
          seed="92"
          result="noise"
        />
        <feGaussianBlur in="noise" stdDeviation="2" result="blurred" />
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="soft" />
        <feDisplacementMap
          in="soft"
          in2="blurred"
          scale="70"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>
    </svg>

    <slot />
  </body>
</html>
