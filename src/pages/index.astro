---
import Base from "../layouts/Base.astro";
import AboutSection from "../components/AboutSection.jsx";
import EducationSection from "../components/EducationSection.jsx";
import ExperienceSection from "../components/ExperienceSection.jsx";
import Footer from "../components/Footer.jsx";
import Glow from "../components/Glow.jsx";
import Motion from "../components/Motion.jsx";
import ProfileCard from "../components/ProfileCard.jsx";
import ProjectsSection from "../components/ProjectsSection.jsx";
import ScrollDots from "../components/ScrollDots.jsx";
import Sidebar from "../components/Sidebar.jsx";
import SkillsSection from "../components/SkillsSection.jsx";
---

<Base>
  <div class="relative">
    <!-- Motion first: it owns no DOM, and the earlier its effect runs the
         sooner `html.motion` drops and the entrance begins — queued last
         behind six other islands, the rail sat hidden for well over a
         second on a cold load. -->
    <Motion client:load />

    <Glow client:load />

    <a href="#main" class="skip-link">Skip to content</a>

    <!-- Scroll dots: the right edge's position indicator, in the slot the
         2px progress rail and, before it, the native scrollbar used to
         fill. The page paints no scrollbar at all now — global.css drops
         the track, thumb and gutter — and which dot is lit comes from the
         same observer as the rail nav and the tab bar. Desktop only: the
         column hides below `lg`, where the tab bar carries navigation and
         the gutter it lived in doesn't exist. -->
    <ScrollDots client:load />

    <!--
      Normal document scroll: the page itself scrolls (no inner viewport),
      so sections size to their content instead of filling a screen.

      `pt-24` on small screens clears the fixed pair of glass pills;
      `lg:pt-0` hands the top spacing back to the rail's own `py-14`.
      Bottom clearance for the floating tab bar lives on the Footer.
    -->
    <div
      class="relative z-10 mx-auto w-full max-w-[1000px] px-5 pt-24 sm:px-8 lg:px-12 lg:pt-0"
    >
      <!-- One row of two columns: the sticky rail and the content. -->
      <div class="grid grid-cols-1 lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-x-16">
        <Sidebar client:load />

        <main id="main">
          <AboutSection />
          <ProjectsSection client:load />
          <ExperienceSection />
          <EducationSection />
          <SkillsSection />

          <Footer />
        </main>
      </div>
    </div>

    <ProfileCard client:load />
  </div>
</Base>
